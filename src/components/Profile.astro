---
import LinkButton from '../components/ui/LinkButton'
import {
  BiLogoGithub,
  BiLogoLinkedinSquare,
  BiDownload,
  BiPhone,
  BiMailSend
} from 'react-icons/bi'
import ProfileType from './ProfileType'
---

<div class='flex-col'>
  <div class='py-8'>
    <picture
      class='flex h-32 w-32 rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-800/80 shadow-sm'
    >
      <source srcset='/assets/profile2.jpeg' type='image/svg+xml' />
      <figure>
        <img
          src='/assets/profile2.jpeg'
          alt='profile picture'
          class='object-cover'
        />
      </figure>
    </picture>
  </div>

  <div class='flex flex-wrap gap-2 pb-5'>
    <LinkButton href='https://github.com/fadomdev' target='_blank'>
      <BiLogoGithub size={16} className='inline' />
      GitHub</LinkButton
    >
    <LinkButton href='https://www.linkedin.com/in/fadom/' target='_blank'>
      <BiLogoLinkedinSquare size={16} className='inline' />
      LinkedIn</LinkButton
    >
    <LinkButton href='/resume.pdf' target='_blank'>
      <BiDownload size={16} className='inline' />
      Descargar CV</LinkButton
    >
  </div>
</div>
<div class='pt-2 h-16 lg:h-20'>
  <ProfileType client:idle />
</div>
<!-- Yo -->
<div class='flex flex-col'>
  <div class='flex flex-col'>
    <h2 class='font-medium text-lg text-zinc-800 dark:text-zinc-100 mb-2'>
      Full Stack Web Developer
    </h2>

    <p class='text-zinc-600 dark:text-zinc-400 text-[14px] leading-relaxed font-normal'>
      Desarrollador Full-Stack con más de 10 años de experiencia en el diseño y
      desarrollo de aplicaciones web. Especializado en PHP (Laravel), JavaScript
      (React) y MySQL, con experiencia en proyectos para sectores educativos y
      logísticos. Busco aplicar mi experiencia en la creación de soluciones
      escalables para optimizar procesos y mejorar la experiencia del usuario
      final.
    </p>
  </div>
  <div
    class='flex flex-wrap gap-2 py-5'
  >
    <LinkButton href='mailto:franciscoaquino19@gmail.com' target='_blank'>
      <BiMailSend size={16} className='inline' />
      franciscoaquino19@gmail.com</LinkButton
    >
    <LinkButton href='tel:+56 9 90479050' target='_blank'>
      <BiPhone size={16} className='inline' />
      +56 9 90479050</LinkButton
    >
  </div>
</div>
