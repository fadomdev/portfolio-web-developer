---
interface Props {
  title: string
}

const { title } = Astro.props
---

<span
  class='inline-block px-2 py-0.5 mr-1 mt-1.5 text-[11px] font-normal text-zinc-500 dark:text-zinc-400 bg-zinc-50/50 dark:bg-zinc-900/20 border border-[0.5px] border-zinc-200/40 dark:border-zinc-800/60 rounded-md transition-colors duration-150 hover:bg-zinc-100/50 dark:hover:bg-zinc-800/30 hover:text-zinc-800 dark:hover:text-zinc-200'
>
  {title}
</span>
