---
import smallProjects from '../data/smallProjects.json'
import { BiLinkExternal } from 'react-icons/bi'
---

<div>
  <h2
    class='text-[11px] font-medium tracking-wider text-zinc-400 dark:text-zinc-500 uppercase mb-6'
  >
    Otros Proyectos
  </h2>

  <div class='grid grid-cols-1 sm:grid-cols-2 gap-6'>
    {
      smallProjects.data.map((project) => (
        <a
          href={project.url}
          target='_blank'
          rel='noopener noreferrer'
          class='group block'
        >
          <div class='relative overflow-hidden rounded-lg bg-zinc-100 dark:bg-zinc-800/60 border border-[0.5px] border-zinc-200/50 dark:border-zinc-800/40'>
            <img
              class='w-full object-cover aspect-video group-hover:scale-[1.02] transition-transform duration-500'
              src={project.image}
              alt={`Captura del proyecto ${project.title}`}
            />
            <div class='absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center'>
              <span class='opacity-0 group-hover:opacity-100 transition-all duration-300 scale-95 group-hover:scale-100 bg-white/90 dark:bg-zinc-900/90 rounded-full p-2 backdrop-blur-sm shadow-md'>
                <BiLinkExternal
                  size={14}
                  className='text-zinc-800 dark:text-zinc-100'
                  client:load
                />
              </span>
            </div>
          </div>
          <div class='mt-2.5 px-0.5'>
            <h3 class='text-sm font-normal text-zinc-800 dark:text-zinc-100 leading-snug group-hover:text-bismark-500 dark:group-hover:text-bismark-400 transition-colors duration-150 truncate'>
              {project.title}
            </h3>
            <p class='text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 line-clamp-2 leading-relaxed'>
              {project.description}
            </p>
            <div class='flex flex-wrap gap-1 mt-1.5'>
              {project.skills.slice(0, 2).map((skill) => (
                <span class='text-[10px] font-normal px-2 py-0.5 border border-[0.5px] border-zinc-200/40 dark:border-zinc-800/60 rounded-md bg-zinc-50/50 dark:bg-zinc-900/20 text-zinc-500 dark:text-zinc-400 transition-colors duration-150 hover:bg-zinc-100/50 dark:hover:bg-zinc-800/30'>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>
