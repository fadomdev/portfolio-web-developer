---
import Work from "./Work.astro";
import works from "../data/works.json";
---

<div>
    <h2 class="text-4xl text-zinc-600 dark:text-zinc-300 font-light mb-10">
        Experiencia
    </h2>

    <ol class="experience-timeline relative">
        {
            works.data.map((work, index) => (
                <Work
                    role={work.role}
                    title={work.title}
                    date={work.date}
                    description={work.description}
                    skills={work.skills}
                    index={index}
                    isLast={index === works.data.length - 1}
                />
            ))
        }
    </ol>
</div>

<style>
    .experience-timeline {
        margin-left: 0.5rem;
    }

    .experience-timeline::before {
        content: "";
        position: absolute;
        left: 0;
        top: 8px;
        bottom: 8px;
        width: 1px;
        background-color: #e4e4e7; /* zinc-200 */
    }

    :global(.dark) .experience-timeline::before {
        background-color: #27272a; /* zinc-800 */
    }
</style>
