---
import skills from '../data/skills.json'
import { Icon } from 'astro-icon/components'

const categories = [
  { key: 'frontend' as const, label: 'Frontend' },
  { key: 'backend'  as const, label: 'Backend' },
  { key: 'tools'    as const, label: 'Base de Datos & Herramientas' },
]

// Assign global staggered delay index across all categories
let delayIdx = 0
const categorizedSkills = categories.map(cat => ({
  ...cat,
  skills: skills.data
    .filter(s => s.category === cat.key)
    .map(s => ({ ...s, animDelay: (delayIdx++) * 40 })),
}))
---

<div class='flex-col mt-4 skills-section'>
  <h2 class='text-4xl text-zinc-600 dark:text-zinc-300 font-light mb-10'>
    Tecnologías
  </h2>

  <div class='flex flex-col gap-8'>
    {categorizedSkills.map(cat => (
      <div>
        <!-- Category label with divider -->
        <div class='flex items-center gap-3 mb-4'>
          <span class='text-[10px] font-medium uppercase tracking-wider text-zinc-400 dark:text-zinc-500'>
            {cat.label}
          </span>
          <div class='flex-1 h-[0.5px] bg-zinc-200/60 dark:bg-zinc-800/40' />
        </div>

        <!-- Skills row -->
        <div class='flex flex-wrap gap-3'>
          {cat.skills.map(skill => (
            <div
              class='skill-card group relative flex flex-col items-center gap-2.5 p-3 pt-4 rounded-xl border border-[0.5px] border-zinc-300/80 dark:border-zinc-800 bg-zinc-50/30 dark:bg-zinc-900/30 backdrop-blur-sm transition-all duration-300 hover:border-zinc-300/80 dark:hover:border-zinc-700 hover:bg-white dark:hover:bg-zinc-900/60 hover:-translate-y-0.5 cursor-default'
              style={`--delay:${skill.animDelay}ms;width:96px`}
            >
              {skill.icon && (
                <div class='icon-wrap relative z-10 w-12 h-12 rounded-lg bg-zinc-50 dark:bg-zinc-950/40 flex items-center justify-center transition-all duration-300 group-hover:scale-105'>
                  <Icon 
                    name={skill.icon} 
                    class='h-8 w-8 text-zinc-600 dark:text-zinc-500 group-hover:text-zinc-800 dark:group-hover:text-zinc-100 transition-colors duration-300' 
                  />
                </div>
              )}

              <p class='relative z-10 text-zinc-500 dark:text-zinc-400 group-hover:text-zinc-900 group-hover:dark:text-zinc-100 text-[11px] font-normal text-center leading-tight transition-colors duration-200 px-0.5'>
                {skill.name.trim()}
              </p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* ── Initial state: hidden before intersection ─────────────────────── */
  .skill-card {
    opacity: 0;
    transform: translateY(12px);
  }

  /* ── Animate in when section enters viewport ───────────────────────── */
  .skills-section.in-view .skill-card {
    animation: skillIn 0.4s ease both;
    animation-delay: var(--delay, 0ms);
  }

  /* ── Entrance keyframe ────────────────────────────────────────────── */
  @keyframes skillIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Trigger entrance animations once the section scrolls into view
  const section = document.querySelector('.skills-section')
  if (section) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add('in-view')
          observer.disconnect()
        }
      },
      { threshold: 0.05 }
    )
    observer.observe(section)
  }
</script>
