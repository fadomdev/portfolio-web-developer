---
import projects from '../data/projects.json'
import { BiLinkExternal } from 'react-icons/bi'
---

<div>
  <h2
    class='text-xs font-bold tracking-widest text-zinc-400 dark:text-zinc-500 uppercase mb-8'
  >
    Proyectos Destacados
  </h2>

  <div class='grid grid-cols-1 sm:grid-cols-2 gap-6'>
    {
      projects.data.map((project, index) => (
        <a
          href={project.url}
          target='_blank'
          rel='noopener noreferrer'
          class='group block'
        >
          <div class='relative overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800'>
            <img
              class='w-full object-cover aspect-video group-hover:scale-[1.04] transition-transform duration-500'
              src={project.image}
              alt={`Captura del proyecto ${project.title}`}
            />
            <div class='absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 flex items-center justify-center'>
              <span class='opacity-0 group-hover:opacity-100 transition-all duration-300 scale-90 group-hover:scale-100 bg-white dark:bg-zinc-900 rounded-full p-3 shadow-lg'>
                <BiLinkExternal
                  size={18}
                  className='text-zinc-800 dark:text-zinc-100'
                  client:load
                />
              </span>
            </div>
            {index === 0 && (
              <span class='absolute top-3 left-3 text-[10px] font-bold tracking-widest uppercase bg-white/90 dark:bg-zinc-900/90 text-zinc-700 dark:text-zinc-200 px-2.5 py-1 rounded-full backdrop-blur-sm'>
                Destacado
              </span>
            )}
          </div>
          <div class='mt-3 px-0.5'>
            <h3 class='font-semibold text-zinc-900 dark:text-zinc-100 text-sm group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors duration-200'>
              {project.title}
            </h3>
            <p class='text-xs text-zinc-500 dark:text-zinc-400 mt-1 line-clamp-2 leading-relaxed'>
              {project.description}
            </p>
            <div class='flex flex-wrap gap-1 mt-2'>
              {project.skills.map((skill) => (
                <span class='text-[10px] font-medium px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700'>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</div>
