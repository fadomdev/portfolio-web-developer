---
import Skill from "./Skill.astro";

interface Props {
    role: string;
    title: string;
    date: string;
    description: string | string[];
    skills: string[];
    index?: number;
    isLast?: boolean;
}

const {
    role,
    title,
    date,
    description,
    skills,
    index = 0,
    isLast = false,
} = Astro.props;

const descArray = typeof description === "string" ? [description] : description;
---

<li class="work-item relative pl-8 pb-10" style={`--i: ${index}`}>
    <!-- Timeline dot -->
    <span
        class="timeline-dot absolute left-[-4px] top-[7px] w-2 h-2 rounded-full bg-zinc-300 dark:bg-zinc-700 transition-all duration-300 z-10"
    >
    </span>

    <!-- Content -->
    <div class="work-content">
        <!-- Header: Role / Title / Date -->
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-2">
            <div class="flex flex-wrap items-baseline gap-x-2">
                <h3 class="text-[15px] font-normal text-zinc-900 dark:text-zinc-50 leading-snug">
                    {title}
                </h3>
                <span class="text-xs text-zinc-400 dark:text-zinc-500 font-light hidden sm:inline">/</span>
                <span class="text-xs text-zinc-500 dark:text-zinc-400 font-normal">
                    {role}
                </span>
            </div>
            <time class="text-xs text-zinc-400 dark:text-zinc-500 tabular-nums">
                {date}
            </time>
        </div>

        <!-- Description -->
        <div class="space-y-2 mb-3 max-w-2xl">
            {
                descArray.map((d) => (
                    <p class="text-[13px] text-zinc-500 dark:text-zinc-400 leading-relaxed font-normal">
                        {d}
                    </p>
                ))
            }
        </div>

        <!-- Skills -->
        <div class="flex flex-wrap gap-1.5">
            {skills.map((skill) => <Skill title={skill} />)}
        </div>
    </div>
</li>

<style>
    /* ── Initial state for scroll animation ───────────────────────────── */
    .work-item {
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.4s ease, transform 0.4s ease;
        transition-delay: calc(var(--i) * 60ms);
    }

    /* ── Visible state ────────────────────────────────────────────────── */
    .work-item.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── Subtle interactions ───────────────────────────────────────────── */
    .work-item:hover .timeline-dot {
        background-color: #438e96; /* bismark-500 */
        box-shadow: 0 0 0 4px rgba(67, 142, 150, 0.15);
    }
</style>

<script>
    // Observe every work item and animate it in when it enters the viewport
    const items = document.querySelectorAll(".work-item");

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.1, rootMargin: "0px 0px -20px 0px" },
    );

    items.forEach((item) => observer.observe(item));
</script>
